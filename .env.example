# Copy to .env and replace every value before a public deployment.

DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="admin@gmial.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Hindu Vista Admin"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. Enquiry email is sent only when all of these are set.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
